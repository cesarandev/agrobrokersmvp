{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/nosotros", "destination": "/Nosotros" },
    { "source": "/productos", "destination": "/Productos" },
    { "source": "/marketplace", "destination": "/Marketplace" },
    { "source": "/producto", "destination": "/Producto" },
    { "source": "/calculadora", "destination": "/Calculadora" },
    { "source": "/blog", "destination": "/Blog" },
    { "source": "/faq", "destination": "/FAQ" },
    { "source": "/sagrilaft", "destination": "/SAGRILAFT" },
    { "source": "/contacto", "destination": "/Contacto" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
